{
  "name": "wispr-flow-clipboard-guard",
  "description": "Patch for Wispr Flow on Windows: dictation no longer pastes the previous clipboard",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "apply": "node --experimental-strip-types --no-warnings src/apply.ts"
  },
  "devDependencies": {
    "@electron/asar": "3.2.17",
    "@types/node": "22.13.10",
    "typescript": "5.8.3"
  }
}
